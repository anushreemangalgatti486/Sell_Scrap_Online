# ============================================
# SCRAPBAZAAR BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# DO NOT commit .env to git
# ============================================

# Server
PORT=5002
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/scrapbazaar
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scrapbazaar

# JWT — generate with: node -e "require('crypto').randomBytes(64).then(b=>console.log(b.toString('hex')))"
# Minimum 32 characters. NEVER use a weak or default value.
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS allowlist — must match your deployed frontend URL)
FRONTEND_URL=http://localhost:5174
# Comma-separated extra origins (e.g., staging domain):
# EXTRA_ORIGINS=https://your-staging-domain.vercel.app,https://your-prod-domain.com

# Cloudinary (Image Storage) — https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payments) — https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook secret — generate at: Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email (Nodemailer) — for Gmail, enable 2FA and use App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ScrapBazaar <noreply@scrapbazaar.in>

# Admin account — seeded ONCE on first run if no admin exists
# CHANGE BOTH VALUES BEFORE DEPLOYING TO PRODUCTION
ADMIN_EMAIL=admin@scrapbazaar.in
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=ScrapBazaar Admin
